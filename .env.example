# WheelSaver Environment Variables — Guia de configuracion

# ============================================================
# OBLIGATORIO (para scraping)
# ============================================================
# GitHub token con permisos SOLO LECTURA (Public Repos)
# https://github.com/settings/tokens
GITHUB_TOKEN=ghp_tu_token_aqui

# ============================================================
# LLM PROVEEDORES — Necesitas AL MENOS UNO para RAG con IA
# ============================================================
# Orden de failover: groq → cerebras → openrouter → nvidia →
# sambanova → mistral → huggingface → google → google-2 → cohere
# Configura solo los que tengas.

# OpenAI-compatible (via openai SDK)
GROQ_API_KEY=
CEREBRAS_API_KEY=
OPENROUTER_API_KEY=
NVIDIA_API_KEY=
SAMBANOVA_API_KEY=
MISTRAL_API_KEY=
HF_API_KEY=                       # HuggingFace Inference

# Proveedores nativos
GOOGLE_API_KEY=                   # Gemini 1.5 Flash (fallback principal)
GOOGLE_API_KEY_2=                 # Gemini secundario (si tienes 2 keys)
COHERE_API_KEY=                   # Cohere Command R+
